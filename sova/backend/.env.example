APP_ENV=development
SECRET_KEY=change-me-to-something-random
DATABASE_URL=sqlite:///./storage/sova.db
CHROMA_DIR=./storage/chroma
ARTIFACT_DIR=./storage/artifacts
UPLOAD_DIR=./uploads

OLLAMA_URL=http://localhost:11434
REASONING_MODEL=qwen2.5:3b-instruct
CODING_MODEL=qwen2.5-coder:1.5b
VISION_MODEL=moondream
EMBED_MODEL_LOCAL=all-MiniLM-L6-v2

MAX_UPLOAD_MB=50
SANDBOX_TIMEOUT_SECONDS=15
OUTBOUND_NETWORK=false

# Set these to prevent sentence-transformers / HuggingFace from phoning home
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
